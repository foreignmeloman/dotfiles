#!/usr/bin/env bash

set -euo pipefail

context=${1-}
namespace=${2-}
external_secret=${3-}

if [[ -z $external_secret ]]; then
  echo "external-secret-view: no ExternalSecret is selected" >&2
  exit 2
fi

# Sofka sends the selected Kubernetes object on stdin. Read it before writing
# output, as required by the package protocol, and avoid fetching the
# ExternalSecret a second time just to discover its target Secret name.
request=$(cat)
secret_name=$(yq eval -r '.object.spec.target.name // ""' <<<"$request")
[[ -n $secret_name ]] || secret_name=$external_secret

kubectl_args=()
[[ -z $context ]] || kubectl_args+=(--context "$context")
[[ -z $namespace ]] || kubectl_args+=(--namespace "$namespace")

printf 'ExternalSecret: %s\n' "$external_secret"
printf 'Target Secret: %s\n' "$secret_name"
printf 'Namespace: %s\n' "$namespace"
printf 'Context: %s\n' "${context:-<current>}"
printf '%s\n' '---'

kubectl "${kubectl_args[@]}" get secret "$secret_name" -o json |
  yq eval -r '.data // {} | to_entries | .[] | .key + ": " + (.value | @base64d)'
